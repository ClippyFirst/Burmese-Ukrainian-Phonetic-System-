{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BurmeseSourceRecord",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "author",
    "year",
    "type",
    "scope",
    "url"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    }
  },
  "additionalProperties": false
}
