{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BurmeseSyllableAnalysis",
  "type": "object",
  "required": ["raw", "codepoints", "onset", "analysis", "status"],
  "properties": {
    "raw": {"type": "string"},
    "codepoints": {"type": "array", "items": {"type": "string"}},
    "onset": {"type": "object"},
    "kinzi": {"type": ["object", "null"]},
    "conjunct": {"type": "array", "items": {"type": "object"}},
    "medials": {"type": "array", "items": {"type": "object"}},
    "vowel": {"type": ["object", "null"]},
    "inherent_vowel": {"type": ["object", "null"]},
    "coda": {"type": ["object", "null"]},
    "tone_mark": {"type": ["object", "null"]},
    "prosody": {"type": "object"},
    "phonology": {"type": "object"},
    "ipa": {"type": ["string", "null"]},
    "analysis": {
      "type": "object",
      "required": ["status", "confidence", "sources", "alternatives"],
      "properties": {
        "status": {"type": "string"},
        "confidence": {"type": "number"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "alternatives": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "status": {"type": "string"}
  },
  "additionalProperties": false
}
