{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BurmesePhonologicalRule",
  "type": "object",
  "required": [
    "rule_id",
    "input",
    "environment",
    "output",
    "status",
    "source_id",
    "claim_id",
    "source_locator",
    "scope",
    "test_reference"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "established",
        "well_supported",
        "analysis_dependent",
        "dialect_dependent",
        "context_dependent",
        "uncertain",
        "disputed",
        "not_established",
        "unsupported"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "test_reference": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
