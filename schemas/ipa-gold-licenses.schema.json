{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "licenses"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "licenses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["redistributable", "commercial_use", "attribution_required", "share_alike"],
        "properties": {
          "redistributable": {"type": "boolean"},
          "commercial_use": {"type": ["boolean", "null"]},
          "attribution_required": {"type": ["boolean", "null"]},
          "share_alike": {"type": ["boolean", "null"]},
          "url": {"type": ["string", "null"], "format": "uri"},
          "note": {"type": "string"}
        }
      }
    }
  }
}