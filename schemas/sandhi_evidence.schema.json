{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BurmeseSandhiSourceEvidence",
  "type": "object",
  "required": [
    "case_id",
    "source_id",
    "source_locator",
    "profile_scope",
    "process_id",
    "source_phonemic_output",
    "source_phonemic_input",
    "gloss",
    "transcription_system",
    "ipa_value",
    "evidence_status",
    "notes"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "source_id": {"const": "NISHI1998_VOICING_RULES"},
    "source_locator": {"type": "string", "minLength": 1},
    "profile_scope": {"type": "string", "minLength": 1},
    "process_id": {
      "enum": ["ATONIC_C1A_C2_VOICING", "NONSTOP_TONAL_RHYME_VOICING"]
    },
    "source_phonemic_output": {"type": "string", "minLength": 1},
    "source_phonemic_input": {"type": "string", "minLength": 1},
    "gloss": {"type": "string", "minLength": 1},
    "transcription_system": {"type": "string", "minLength": 1},
    "ipa_value": {"const": ""},
    "evidence_status": {"const": "SOURCE_ATTESTED_NOT_IPA"},
    "notes": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
